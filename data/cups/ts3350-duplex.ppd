*PPD-Adobe: "4.3"
*% "Canon TS3350" virtual printer: manual duplex through ts3350-toolset.
*% The ts3350-duplex backend receives the PDF produced by pdftopdf and forwards it to the real queue.
*FormatVersion: "4.3"
*FileVersion: "1.0"
*LanguageVersion: English
*LanguageEncoding: ISOLatin1
*PCFileName: "TS3350DX.PPD"
*Product: "(Canon TS3350)"
*Manufacturer: "Canon"
*ModelName: "Canon TS3350 Manual Duplex"
*ShortNickName: "Canon TS3350 Duplex"
*NickName: "Canon TS3350, manual duplex (ts3350-toolset)"
*PSVersion: "(3010.000) 0"
*LanguageLevel: "3"
*ColorDevice: True
*DefaultColorSpace: RGB
*FileSystem: False
*Throughput: "1"
*LandscapeOrientation: Minus90
*TTRasterizer: Type42
*cupsVersion: 2.4
*cupsLanguages: "fr"
*cupsSingleFile: True
*cupsManualCopies: True
*% Each copy of an odd-page document starts on a new sheet.
*cupsEvenDuplex: True
*cupsFilter2: "application/pdf application/vnd.cups-pdf 0 -"

